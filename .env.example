# Supabase local (valores por defecto de `npx supabase start`; `npx supabase status` los muestra)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Solo server: escribe el cache de lugares de Google en `places`. Copiar SECRET_KEY de `npx supabase status`
SUPABASE_SECRET_KEY=

# Password de las cuentas demo creadas en supabase/seed.sql
DEMO_PASSWORD=rumbo-demo-2026

# Voz en tiempo real (OpenAI Realtime)
OPENAI_API_KEY=sk-...
# REALTIME_MODEL=gpt-realtime-2.1-mini
# VOICE=marin

# Google Places API (New): lugares cercanos. Sin key, la app usa lo que ya haya en `places`.
GOOGLE_API_KEY=

# Búsqueda web rápida (serper.dev): menús, eventos, lo que Google Places no sabe
SERPER_API_KEY=

# UI generativa (OpenUI): el modelo que arma las pantallas de /talk.
# Con GROQ_API_KEY usa Groq (muy rápido); si no, OpenAI con OPENAI_API_KEY.
GROQ_API_KEY=
# GENUI_MODEL=llama-3.3-70b-versatile   (Groq) · gpt-4.1-mini (OpenAI, default)
