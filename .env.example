# Supabase local (valores por defecto de `npx supabase start`; `npx supabase status` los muestra)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Solo server: escribe el cache de lugares de Google en `places`. Copiar SECRET_KEY de `npx supabase status`
SUPABASE_SECRET_KEY=

# Password de las cuentas demo creadas en supabase/seed.sql
DEMO_PASSWORD=rumbo-demo-2026

# Voz en tiempo real (OpenAI Realtime)
OPENAI_API_KEY=sk-...
# REALTIME_MODEL=gpt-realtime-2.1-mini
# VOICE=marin

# Google Places API (New): lugares cercanos. Sin key, la app usa lo que ya haya en `places`.
GOOGLE_API_KEY=

# Búsqueda web rápida (serper.dev): menús, eventos, lo que Google Places no sabe
SERPER_API_KEY=

# UI generativa (OpenUI): el modelo que arma las pantallas de /talk.
# Por defecto gpt-6-luna con OPENAI_API_KEY (el más barato que pasó nuestro benchmark).
# GENUI_MODEL=gpt-5.4-mini   (un poco más rápido, 8x más caro)
# Opcional: con GROQ_API_KEY usa Groq.
GROQ_API_KEY=

# Visión (C-3): Jev elige entre los lugares cercanos; si no es ninguno, responde el LLM.
# Key de Jev en https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest
# VISION_MODEL=gpt-5.6-luna
# Extracción de recomendaciones de residentes por turno (C-5, /api/translate/tips)
# TIPS_MODEL=gpt-6-luna

# Avisos por cercanía (C-6): pausa mínima entre avisos, en segundos.
# NOTIFY_COOLDOWN_SECONDS=60
